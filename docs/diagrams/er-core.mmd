erDiagram
    USERS { bigint id PK
            string name
            string email
            string account_type
            string status
            bigint user_group_id FK }
    ADDRESSES { bigint id PK
                bigint user_id FK
                string city
                string state
                string pincode }
    CATEGORIES { bigint id PK
                 bigint parent_id FK
                 string name
                 string slug
                 boolean is_active }
    PRODUCTS { bigint id PK
               bigint category_id FK
               bigint seller_id FK
               string title
               string sku
               float price
               int quantity
               int reserved
               string stock_status
               string owner_type }
    USER_GROUPS { bigint id PK
                  string name }
    USERS ||--o{ ADDRESSES : has
    USERS ||--o{ USER_GROUPS : belongs_to
    CATEGORIES ||--o{ CATEGORIES : parent_of
    CATEGORIES ||--o{ PRODUCTS : contains
    USERS ||--o{ PRODUCTS : sells
